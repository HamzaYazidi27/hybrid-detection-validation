// id: HYB-V02
// title: Credential changes on the Entra Connect application
// module: 2.1
// tables: AuditLogs
// licensing_gates: LIC-001
// watchlists: HDV_EntraConnect
// status: not executed
// expected: only Connect's own automatic certificate rotation (baseline for planned DET-HYB-002); no client secrets added
let ConnectAppId = toscalar(_GetWatchlist("HDV_EntraConnect") | project tostring(ConnectAppId) | take 1);
AuditLogs
| where TimeGenerated > ago(30d)
| where OperationName has_any ("Certificates and secrets management", "Add service principal credentials", "Remove service principal credentials")
// TargetResources/AdditionalDetails field layout for application credentials is not pinned yet: match the app ID anywhere in them.
| where tostring(TargetResources) has ConnectAppId or tostring(AdditionalDetails) has ConnectAppId
| extend Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName), tostring(InitiatedBy.app.servicePrincipalId))
| project TimeGenerated, OperationName, Result, Actor, CorrelationId
| order by TimeGenerated desc
